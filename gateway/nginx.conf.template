map_hash_bucket_size 128;

map $http_x_tiangong_gateway_token $tiangong_gateway_authorized {
    default 0;
    "${TIANGONG_GATEWAY_TOKEN}" 1;
}

server {
    listen 7457;
    server_name _;
    server_tokens off;

    client_max_body_size 64m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location ~* \.(?:map)$ {
        return 404;
    }

    location = /api/version {
        if ($tiangong_gateway_authorized = 0) {
            return 401;
        }
        default_type application/json;
        return 200 '{"version":"1.0.0","channel":"production","packaged":true,"platform":"web","arch":"server"}';
    }

    location = /api/health {
        if ($tiangong_gateway_authorized = 0) {
            return 401;
        }
        default_type application/json;
        return 200 '{"ok":true,"service":"tiangong"}';
    }

    location / {
        if ($tiangong_gateway_authorized = 0) {
            return 401;
        }

        proxy_pass http://open-design:7456;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_set_header Authorization "Bearer ${OD_API_TOKEN}";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";

        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
        proxy_hide_header X-Nextjs-Cache;
        proxy_hide_header X-Nextjs-Prerender;
        proxy_hide_header X-Nextjs-Stale-Time;
    }
}
