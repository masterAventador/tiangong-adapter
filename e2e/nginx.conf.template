server {
    listen 7458;
    server_name _;
    server_tokens off;

    location / {
        proxy_pass http://tiangong-gateway:7457;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;

        proxy_set_header X-Tiangong-Gateway-Token "${TIANGONG_GATEWAY_TOKEN}";
        proxy_set_header Origin "https://tiangong.xuanbai.tech";
        proxy_set_header Host "tiangong.xuanbai.tech";
        proxy_set_header X-Forwarded-Host "tiangong.xuanbai.tech";
        proxy_set_header X-Forwarded-Proto "https";
        proxy_set_header Connection "";
    }
}
