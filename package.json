{
  "name": "tiangong-wan-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible image API adapter for Alibaba Cloud Model Studio Wan 2.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
