# Open Design 填入 Custom Image API 的内部令牌，不要与百炼 Key 共用。
ADAPTER_API_KEY=replace-with-a-random-internal-token

# 阿里云百炼 API Key，只保存在适配器服务端。
DASHSCOPE_API_KEY=sk-replace-me

# 请替换为百炼控制台显示的业务空间专属域名，不要包含末尾的 /api/v1。
# 北京：https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com
# 新加坡：https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com

# 默认只允许用户已选定的普通版 Wan 2.7，避免误用更贵模型。
ALLOWED_MODELS=wan2.7-image

PORT=8080
HOST=0.0.0.0
REQUEST_TIMEOUT_MS=180000
MAX_BODY_BYTES=31457280

# 下面几项只在使用 compose.example.yaml 同时启动天工时需要。
OD_API_TOKEN=replace-with-another-random-token
OPEN_DESIGN_ALLOWED_ORIGINS=
OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:latest
OPEN_DESIGN_MEM_LIMIT=1g
OPEN_DESIGN_PORT=7456

# 临时单账号登录。账号可以明文配置，密码必须先转换成 scrypt 摘要。
TIANGONG_LOGIN_USERNAME=authorized-user@example.com
TIANGONG_LOGIN_PASSWORD_HASH='scrypt$16384$8$1$replace-with-base64url-salt$replace-with-base64url-digest'
